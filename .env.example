# ---------------------------------------------------------------- Supabase
# 로컬 개발: npx supabase start 출력의 API_URL 과 SECRET_KEY
# 클라우드:   대시보드 → Project Settings → API
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------- 세션
# 세션 쿠키 서명 키. 배포할 때 반드시 새로 만들 것:
#   openssl rand -base64 32
SESSION_SECRET=

# ---------------------------------------------------------------- 로그인 계정
# 사이트 전체가 로그인 뒤에 있다. 아이디와 비밀번호가 모두 있어야 그 계정이 살아난다.
#
# 값에 # 이 들어가면 반드시 따옴표로 감쌀 것 — 감싸지 않으면 그 뒤가 주석으로
# 잘려나가 비밀번호가 조용히 짧아진다.  예: ADMIN_PASSWORD="a1b2c3#"
# (Vercel 대시보드에 넣는 값은 그대로 저장되므로 따옴표가 필요 없다)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 가족 계정은 아래 둘을 채우면 열린다. 비워두면 관리자만 들어올 수 있다.
FAMILY_USERNAME=
FAMILY_PASSWORD=

# ---------------------------------------------------------------- dev 전용
# dev 서버를 localhost 아닌 주소로 열 때 허용할 호스트 (쉼표 구분).
# 배포(build + start)에서는 필요 없다.
DEV_ORIGINS=

# ---------------------------------------------------------------- Google Drive
# 원본 파일이 저장되는 곳. Google Cloud Console 에서 OAuth 클라이언트(웹 애플리케이션)를
# 만들고 아래 두 값을 넣는다. 권한 범위는 drive.file 하나 — 이 앱이 만든 파일에만 접근한다.
#
# 승인된 리디렉션 URI 에 다음을 등록할 것:
#   https://<배포주소>/api/google/callback
#   http://localhost:8443/api/google/callback   (로컬 개발용)
#
# 리프레시 토큰은 여기 넣지 않는다. 관리 화면 → 저장소 → "Google Drive 연결" 로
# 발급받아 DB(app_setting)에 저장된다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 리디렉션 URI 를 고정하고 싶을 때만. 비우면 접속한 주소에서 자동으로 만든다.
GOOGLE_REDIRECT_URI=

# Drive 최상위 폴더 이름 (기본값: 도당동 아카이브)
DRIVE_ROOT_FOLDER_NAME=
